# OpenVINO Runtime Core + Inference
shared_library("openvino") {
  output_name = "openvino"
  configs += [
    ":openvino_config",
    ":openvino_internal_config",
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
  ]
  configs -= [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    ":warnings_config",
  ]

  sources = [
    # Core sources are provided by openvino_core_sources

    # ITT
    "src/common/itt/src/itt.cpp",

    # Shutdown
    "src/common/shutdown/shutdown.cpp",

    # Transformations and utilities
    "src/common/util/src/common_util.cpp",
    "src/common/util/src/env_util.cpp",
    "src/common/util/src/file_path.cpp",
    "src/common/util/src/file_util.cpp",
    #"src/common/util/src/log.cpp",
    "src/common/util/src/weights_path.cpp",
    "src/common/util/src/wstring_convert_util.cpp",
    "src/common/util/src/xml_parse_utils.cpp",
    "src/common/util/src/os/win/win_shared_object_loader.cpp",

    # Frontend common
    "src/frontends/common/src/manager.cpp",
    "src/frontends/common/src/frontend.cpp",
    "src/frontends/common/src/input_model.cpp",
    "src/frontends/common/src/place.cpp",
    "src/frontends/common/src/plugin_loader.cpp",
    "src/frontends/common/src/decoder.cpp",
    "src/frontends/common/src/exception.cpp",
  ]

  defines = [
    "IMPLEMENT_OPENVINO_API",
    "FRONTEND_LIB_PREFIX=\"openvino_\"",
    "OpenVINO_VERSION=\"2026.1.0\"",
    "OV_NATIVE_PARENT_PROJECT_ROOT_DIR=\"openvino\"",
  ]

  if (is_debug) {
    defines += [ "FRONTEND_LIB_SUFFIX=\"_frontendd.dll\"" ]
  } else {
    defines += [ "FRONTEND_LIB_SUFFIX=\"_frontend.dll\"" ]
  }

  deps = [
    ":openvino_core_sources",
    ":openvino_descriptor",
    ":openvino_pass",
    ":openvino_pattern",
    ":openvino_reference",
    ":openvino_reference_utils",
    ":openvino_runtime",
    ":openvino_transformations",

    # TBB, nlohmann_json, pugixml, etc.
    "//third_party/pugixml",
    "//third_party/oneTBB:tbb",
    "//third_party/xbyak",
  ]
}


