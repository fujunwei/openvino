import("//build/config/features.gni")

config("warnings_config") {
  cflags = [
    # TODO(crbug.com/463723474): Try to clean/remove these suppressions if possible.
    "-Wno-mismatched-tags",
    "-Wno-implicit-const-int-float-conversion",
    "-Wno-deprecated-declarations",
    "-Wno-shadow",

    # TODO(crbug.com/1147556): Try to clean/remove no-sign-compare if possible.
    "-Wno-sign-compare",

    # TODO
    "-Wno-unused-private-field",
  ]
  visibility = [ ":*" ]
}

config("openvino_config") {
  include_dirs = [
    # The src/core/src must be first to include the itt.hpp
    "src/core/src",
    "src/core/include",
    "src/core/dev_api",
    "src/inference/include",
    "src/inference/dev_api",
    "src/common/util/include",
    "src/common/transformations/include",
    "src/common/low_precision_transformations/include",
    "src/common/offline_transformations/include",
    "src/common/shutdown/include",
    "src/core/shape_inference/include",
    "src/common/itt/include",
    "src/common/conditional_compilation/include",
    "src/common/conditional_compilation/include/openvino/cc",
    "src/frontends/common/include",
    "//third_party/pugixml/src",
    "//third_party/xbyak",
    "thirdparty/ittapi/include",
    "//third_party/oneTBB/include",

    # Additional include dirs for source compilation
    "src/inference/src",
    "src/core/reference/include",
    "src/common/util/src",
    "src/common/transformations/src",
    "//third_party/nlohmann_json/src/include",
  ]

  defines = [
    "IE_THREAD=IE_THREAD_TBB",
    "IMPLEMENT_OPENVINO_RUNTIME_API",
    "__TBB_NO_IMPLICIT_LINKAGE=1",
  ]

  if (is_win) {
    defines += [ "_CRT_SECURE_NO_WARNINGS" ]
    if (is_debug) {
      defines += [ "OV_BUILD_POSTFIX=\"d\"" ]
    } else {
      defines += [ "OV_BUILD_POSTFIX=\"\"" ]
    }
  } else if (is_apple) {
    if (is_debug) {
      defines += [ "OV_BUILD_POSTFIX=\"d\"" ]
    } else {
      defines += [ "OV_BUILD_POSTFIX=\"\"" ]
    }
  } else {
    defines += [ "OV_BUILD_POSTFIX=\"\"" ]
  }
}

config("openvino_internal_config") {
  if (is_clang) {
    cflags = [
      "-Wno-extra-semi",
      "-Wno-deprecated-declarations",
      "-Wno-exit-time-destructors",
    ]
  }
  if (is_win) {
    cflags_cc = [ "/std:c++17" ]
  } else {
    cflags_cc = [ "-std=c++17" ]
  }
}

